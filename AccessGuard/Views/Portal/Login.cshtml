<div class="auth-stage" id="page-content">
    <div class="lamp-scene" id="lamp-scene" aria-hidden="true"><div class="lamp-wire"></div><div class="lamp-shade"></div><div class="lamp-beam"></div></div>
    <section class="hanging-wrap" aria-labelledby="login-title"><div class="suspension" aria-hidden="true"><i></i><i></i></div><div class="hanging-card">
        <div class="card-window"><span>accessguard / authentification</span><button type="button" id="lamp-toggle" class="lamp-toggle" aria-label="Éteindre la lampe" aria-pressed="true"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18h6M10 21h4M8 13a6 6 0 1 1 8 0c-1 1-1 2-1 3H9c0-1 0-2-1-3Z"/></svg></button></div>
        <div class="login-body"><div class="lock-mark" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="11" rx="3"/><path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3"/></svg></div><div class="auth-heading"><h2 id="login-title">Ravi de vous retrouver.</h2><p>Connectez-vous à votre organisation.</p></div>
        <form id="login-form"><label for="login-email">Adresse e-mail</label><input id="login-email" name="email" type="email" autocomplete="username" placeholder="vous@entreprise.test"  required /><label for="login-password">Mot de passe <span class="field-hint">IDENTITY</span></label><div class="password-field"><input id="login-password" name="password" type="password" autocomplete="current-password" placeholder="Votre mot de passe"  required /><button id="show-password" type="button" aria-label="Afficher le mot de passe">Voir</button></div><label id="login-code-label" for="login-code">Code 2FA <span class="field-hint">GOOGLE AUTHENTICATOR</span></label><input id="login-code" name="code" class="code-field" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" placeholder="000 000" aria-describedby="login-demo-note login-error" required /><p class="login-demo-note" id="login-demo-note">Le code est demandé uniquement si votre compte utilise la double authentification.</p><p id="login-error" class="form-message" role="alert"></p><button class="button primary full" type="submit">Accéder au portail <span aria-hidden="true">→</span></button></form>
        <div class="auth-bottom"><span class="status-dot"></span>Session Identity · cookie HttpOnly</div><a href="/Portal/Setup2FA" class="setup-link">Configurer mon application 2FA <span aria-hidden="true">↗</span></a></div>
    </div><p class="hanging-caption">IDENTITÉ VÉRIFIÉE. ACCÈS MAÎTRISÉ.</p></section>
</div>
