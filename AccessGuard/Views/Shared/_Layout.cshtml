@{
    string currentPage = ViewData["Page"]?.ToString() ?? "dashboard";
    bool isLoginPage = currentPage == "login";
    bool authPage = isLoginPage || currentPage == "setup";
    var links = new[] { ("dashboard", "/", "Vue d’ensemble"), ("users", "/Portal/Users", "Utilisateurs"), ("roles", "/Portal/Roles", "Permissions"), ("audit", "/Portal/Audit", "Audit") };
}
<!DOCTYPE html><html lang="fr"><head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><meta name="theme-color" content="#edf2f5" />
<title>@ViewData["Title"] · AccessGuard</title>
<script>try{if(!sessionStorage.getItem('ag-entered-v1')){document.documentElement.classList.add('first-entry');sessionStorage.setItem('ag-entered-v1','1');}}catch{}</script>
<link rel="stylesheet" href="~/css/professional.css" asp-append-version="true" />
@await RenderSectionAsync("Styles", required: false)
</head><body>
<div class="entry-screen" tabindex="-1" role="region" aria-labelledby="entry-title"><div class="entry-mark"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 8 3v6c0 4-5 7-8 9-3-2-8-5-8-9V6Z"/><path d="m8 12 3 3 5-6"/></svg></div><strong id="entry-title">AccessGuard<span>.</span></strong><span class="entry-caption" id="entry-stage" role="status" aria-live="polite">VOTRE ESPACE DE GESTION DES ACCÈS</span><span class="entry-line" aria-hidden="true"></span><span class="entry-context">Ouverture du portail AccessGuard</span></div>
<a class="skip-link" href="#main-content">Aller au contenu</a>
<div class="app-shell @(authPage ? "auth-shell" : "")" data-page="@(currentPage)">
<header class="workspace-header"><a class="brand" href="/" aria-label="AccessGuard, vue d’ensemble"><span class="brand-symbol"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 8 3v6c0 4-5 7-8 9-3-2-8-5-8-9V6Z"/><path d="m8 12 3 3 5-6"/></svg></span><span>AccessGuard<span class="brand-dot">.</span><small>IDENTITÉS & ACCÈS</small></span></a>
@if (!isLoginPage)
{
<button type="button" id="open-command" class="command-trigger" aria-haspopup="dialog" aria-controls="command-palette" aria-label="Rechercher un écran"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10" cy="10" r="6"/><path d="m15 15 5 5"/></svg><span>Rechercher</span><kbd>Ctrl K</kbd></button>
}
</header>
<main id="main-content" tabindex="-1"><div class="environment-strip"><span class="workspace-label"><span class="workspace-dot"></span>Organisation AccessGuard <span class="workspace-separator">/</span> Console d’administration</span><span class="demo-label">Base SQLite · accès contrôlés</span></div>@RenderBody()</main>
<footer><span class="footer-brand">AccessGuard .NET <small>Projet académique</small></span><span class="footer-note">Comptes et permissions contrôlés côté serveur</span><a id="backend-session-link" class="text-link" href="/Portal/Account">Mon compte</a></footer>
</div>
@if (!isLoginPage)
{
<nav class="magnetic-dock" aria-label="Navigation principale"><div class="dock-handle" aria-hidden="true"></div><div class="dock-items"><a class="dock-item @(currentPage == "dashboard" ? "is-active" : "")" data-dock-id="dashboard" href="/" aria-label="Vue d’ensemble" aria-current="@(currentPage == "dashboard" ? "page" : null)"><span class="dock-tooltip" aria-hidden="true">Vue d’ensemble</span><span class="dock-tile dock-dashboard"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="2"/><rect x="14" y="3" width="7" height="7" rx="2"/><rect x="3" y="14" width="7" height="7" rx="2"/><rect x="14" y="14" width="7" height="7" rx="2"/></svg></span><span class="dock-indicator" aria-hidden="true"></span></a><a class="dock-item @(currentPage == "users" ? "is-active" : "")" data-dock-id="users" href="/Portal/Users" aria-label="Utilisateurs" aria-current="@(currentPage == "users" ? "page" : null)"><span class="dock-tooltip" aria-hidden="true">Utilisateurs</span><span class="dock-tile dock-users"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="9" cy="8" r="3"/><path d="M3 21v-3a6 6 0 0 1 12 0v3m2-17a3 3 0 0 1 0 6m1 4a5 5 0 0 1 3 4v3"/></svg></span><span class="dock-indicator" aria-hidden="true"></span></a><a class="dock-item @(currentPage == "roles" ? "is-active" : "")" data-dock-id="roles" href="/Portal/Roles" aria-label="Permissions" aria-current="@(currentPage == "roles" ? "page" : null)"><span class="dock-tooltip" aria-hidden="true">Permissions</span><span class="dock-tile dock-roles"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="3"/><path d="M3 10h18M10 4v16m6-6v3m-3-1h6"/></svg></span><span class="dock-indicator" aria-hidden="true"></span></a><a class="dock-item @(currentPage == "audit" ? "is-active" : "")" data-dock-id="audit" href="/Portal/Audit" aria-label="Audit" aria-current="@(currentPage == "audit" ? "page" : null)"><span class="dock-tooltip" aria-hidden="true">Audit</span><span class="dock-tile dock-audit"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h9l4 4v14H6Z"/><path d="M14 3v5h5M9 12h7m-7 4h5"/></svg><span class="dock-badge" id="dock-alerts" hidden></span></span><span class="dock-indicator" aria-hidden="true"></span></a><a class="dock-item @(currentPage == "setup" ? "is-active" : "")" data-dock-id="setup" href="/Portal/Setup2FA" aria-label="Sécurité 2FA" aria-current="@(currentPage == "setup" ? "page" : null)"><span class="dock-tooltip" aria-hidden="true">Sécurité 2FA</span><span class="dock-tile dock-setup"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m12 3 8 3v6c0 4-5 7-8 9-3-2-8-5-8-9V6Z"/><path d="m8 12 3 3 5-6"/></svg></span><span class="dock-indicator" aria-hidden="true"></span></a><a class="dock-item @(currentPage == "account" ? "is-active" : "")" data-dock-id="account" href="/Portal/Account" aria-label="Mon compte" aria-current="@(currentPage == "account" ? "page" : null)"><span class="dock-tooltip" aria-hidden="true">Mon compte</span><span class="dock-tile dock-account"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></svg></span><span class="dock-indicator" aria-hidden="true"></span></a></div></nav>
<dialog id="command-palette" class="command-dialog" aria-labelledby="command-title"><div class="command-heading"><h2 id="command-title">Où souhaitez-vous aller ?</h2><button type="button" id="close-command" class="icon-button" aria-label="Fermer la recherche">×</button></div><label class="sr-only" for="command-search">Rechercher un écran</label><input id="command-search" role="combobox" aria-autocomplete="list" aria-expanded="true" aria-controls="command-results" type="search" placeholder="Utilisateurs, permissions, audit…" autocomplete="off" /><div id="command-results" class="command-results" role="listbox" aria-label="Écrans disponibles"></div><p class="command-help">↑ ↓ pour parcourir · Entrée pour ouvrir · Échap pour fermer</p></dialog>
}
<dialog id="user-dialog" aria-labelledby="dialog-title"><form id="user-form"><div class="dialog-heading"><h2 id="dialog-title">Ajouter un utilisateur</h2><button type="button" id="close-dialog" class="icon-button" aria-label="Fermer">×</button></div><p class="muted">Compte enregistré dans la base de données de l’organisation.</p><input type="hidden" name="id" /><label>Nom complet<input name="name" required maxlength="80" autocomplete="off" /></label><label>Adresse e-mail<input name="email" type="email" required maxlength="120" autocomplete="off" /></label><label id="initial-password-label">Mot de passe initial<input name="password" type="password" minlength="12" maxlength="256" autocomplete="new-password" /></label><label>Rôle<select name="role"><option>Administrateur</option><option>Auditeur</option><option>Employé</option></select></label><label>Statut<select name="status"><option>Actif</option><option>Désactivé</option></select></label><p id="form-error" role="alert"></p><div class="dialog-actions"><button type="button" id="cancel-dialog" class="button secondary">Annuler</button><button class="button primary" type="submit">Enregistrer</button></div></form></dialog>
<div id="toast" role="status" aria-live="polite"></div>
@if(currentPage == "setup"){<script src="~/js/vendor/qrcode.min.js" asp-append-version="true" defer></script>}
<script src="~/js/site.js" asp-append-version="true" defer></script><script src="~/js/professional.js" asp-append-version="true" defer></script>
@await RenderSectionAsync("Scripts", required: false)
</body></html>
